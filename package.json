{
  "name": "eyewear-store",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:frontend": "pnpm --parallel --filter capri-storefront --filter eyewear-vto-web dev",
    "dev:backend": "concurrently -n backend,vision-measure -c blue,magenta \"pnpm --filter @eyewear/backend dev\" \"cd apps/vision-measure && uv run python services/api/vision_api.py\"",
    "build": "pnpm --filter './packages/*' build && pnpm --filter './apps/*' build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "node scripts/check-i18n.mjs && pnpm --recursive test",
    "check:i18n": "node scripts/check-i18n.mjs",
    "reindex": "pnpm --filter backend reindex"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "proxy-addr": "^2.0.8",
      "qs": "^6.16.0",
      "compression": "^1.8.2",
      "multer": "^2.4.0",
      "axios": "^1.20.0",
      "handlebars": "^4.7.10",
      "shell-quote": "^1.11.0",
      "follow-redirects": "^1.16.1",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.0.3",
      "brace-expansion@4": "^4.0.1",
      "brace-expansion@5": "^5.0.12",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "lodash": "^4.18.0",
      "nanoid@3": "^3.3.18",
      "browserslist": "^4.28.7",
      "source-map-js": "^1.2.2",
      "postcss": "^8.5.23",
      "postcss-selector-parser@7": "^7.1.6",
      "uuid@11": "^11.1.1",
      "react-router-dom@6": "^6.30.6",
      "react-router@6": "^6.30.6",
      "ajv@8": "^8.18.0",
      "morgan": "^1.12.1",
      "csv-parse@7": "^7.0.2",
      "@graphql-tools/utils": "^12.0.2",
      "baseline-browser-mapping": "^2.11.0"
    }
  }
}
