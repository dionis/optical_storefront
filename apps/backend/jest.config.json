{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>/tests"],
  "moduleNameMapper": {
    "^@eyewear/shared$": "<rootDir>/../../packages/shared/src/index.ts"
  },
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", {
      "tsconfig": {
        "module": "CommonJS",
        "moduleResolution": "Node"
      }
    }]
  }
}
