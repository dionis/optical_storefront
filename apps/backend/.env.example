# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
# Local dev (docker-compose):
DATABASE_URL=postgres://eyewear:eyewear@localhost:5432/eyewear
# Production (Supabase): use the direct connection (port 5432, not the 6543
# pooler) — the backend runs as a persistent server, not serverless, so it
# doesn't need pgbouncer. Copy from Project Settings > Database > Connection
# string. If your connection pool gets exhausted on the free tier, switch to
# the session pooler string instead.
# DATABASE_URL=postgres://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────
# Medusa auth / CORS
# ─────────────────────────────────────────────
JWT_SECRET=change-me-in-production
COOKIE_SECRET=change-me-in-production
# Comma-separated list of allowed storefront origins for the Store API.
# MUST include the capri-storefront SPA origin, or browser requests are blocked.
#   - dev: the Vite dev server runs on port 5198 (see apps/capri-storefront
#     package.json `dev` script) → http://localhost:5198
#   - prod: the deployed Vercel domain (and any custom domain).
STORE_CORS=http://localhost:5198,https://your-storefront.vercel.app
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000
BACKEND_URL=http://localhost:9000

# ─────────────────────────────────────────────
# Cloudflare R2 (S3-compatible)
# ─────────────────────────────────────────────
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=eyewear-assets
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
# Public CDN URL for assets (Cloudflare custom domain or r2.dev)
R2_PUBLIC_URL=https://assets.example.com
# Private bucket for prescription images (PHI). Defaults to R2_BUCKET if not set.
R2_PRESCRIPTION_BUCKET=eyewear-prescriptions

# ─────────────────────────────────────────────
# Meilisearch
# ─────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=change-me-in-production

# ─────────────────────────────────────────────
# Stripe
# ─────────────────────────────────────────────
# Secret key of the Stripe environment you are pointing at. Each sandbox has its
# own key — a key from a different sandbox than the one holding the webhook
# below silently breaks signature verification.
STRIPE_SECRET_KEY=sk_test_...
# Signing secret of the webhook endpoint (NOT an API key). Register the endpoint
# at Developers → Webhooks with URL:
#   https://<backend-host>/hooks/payment/stripe_stripe
# The `stripe_stripe` segment is the provider id: the payment module resolves
# `pp_${segment}`, and the provider is registered as pp_stripe_stripe.
# Events to subscribe: payment_intent.succeeded and
# payment_intent.amount_capturable_updated — the only two Medusa's webhook
# subscriber acts on.
# Without this the backend still boots, but a customer who pays through a
# redirect method (Klarna, Affirm, Cash App Pay) and never returns to the site
# is charged with no order created: this webhook is the only recovery path.
# Note: the /hooks route answers 200 before the signature is checked, so a wrong
# value shows as success in Stripe and only surfaces in the backend logs.
STRIPE_WEBHOOK_SECRET=whsec_...
# Payments are captured automatically on confirmation (`capture: true` in
# medusa-config.ts). There is no env switch for it — flipping that flag off
# reverts to authorize-only, which leaves every charge "Uncaptured" in Stripe
# and expiring after ~7 days, since nothing in this codebase captures later.

# ─────────────────────────────────────────────
# PayPal
# ─────────────────────────────────────────────
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
# PayPal's return/cancel redirects use STOREFRONT_URL — declared once, further
# down under "Storefront URL".

# ─────────────────────────────────────────────
# Square
# ─────────────────────────────────────────────
SQUARE_ACCESS_TOKEN=your-square-sandbox-token
SQUARE_LOCATION_ID=your-square-location-id
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=your-square-webhook-signature-key

# ─────────────────────────────────────────────
# Anthropic (OCR)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Defaults for prescription OCR. Operators can override the model, the
# escalation model and the image size from Admin → "OCR de recetas"; these
# values apply until they do, and OCR_ALLOWED_MODELS always wins over both.

# Model used for the first read attempt. Sonnet is the default because Haiku
# misread an axis on a real handwritten prescription — a silent error no
# validation catches. Switch to claude-haiku-4-5 only if your prescriptions
# arrive printed.
OCR_MODEL=claude-sonnet-5
# Retried only when the first read comes back unusable. Set to "none" to disable.
OCR_ESCALATION_MODEL=claude-opus-5
# Longest edge images are downscaled to before being sent. Cost scales with
# area, so this is the biggest single lever on the bill (min 640, max 2576).
OCR_MAX_IMAGE_PX=1568
# Models an operator is allowed to select. Narrow it to forbid the pricey tier.
OCR_ALLOWED_MODELS=claude-haiku-4-5,claude-sonnet-5,claude-opus-5
# Reads per IP per hour on the public endpoint. The endpoint is unauthenticated
# and every call spends money, so this is a spending cap first of all.
OCR_RATE_LIMIT_PER_HOUR=20

# ─────────────────────────────────────────────
# Resend (transactional email)
# ─────────────────────────────────────────────
RESEND_API_KEY=re_...
# Must belong to a domain verified at resend.com/domains. The shared sandbox
# sender onboarding@resend.dev only delivers to the Resend account's own
# address — every other recipient is rejected with a 403.
RESEND_FROM_EMAIL=orders@example.com
# Where the store's copy of each paid order is sent. Falls back to
# RESEND_FROM_EMAIL when unset.
STORE_ORDER_NOTIFICATION_EMAIL=store@example.com
# Language for the store-facing email ("es" default, "en"). The customer's copy
# follows the locale carried on the order instead.
STORE_NOTIFICATION_LOCALE=es

# ─────────────────────────────────────────────
# Twilio (order confirmation SMS) — optional
# ─────────────────────────────────────────────
# When all three are set, paid orders also send an SMS: to the customer when
# they opted in at checkout (and we have their phone), and to the owner number
# below. Leave unset to keep SMS on the logging fallback (the backend still boots).
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# SMS-capable sender: an E.164 number (e.g. +13055551234) or a Messaging
# Service SID (starts with MG...).
TWILIO_FROM_NUMBER=+10000000000
# Owner phone (E.164) that receives an SMS heads-up for each new order. Leave
# unset to skip the owner SMS copy.
STORE_ORDER_NOTIFICATION_SMS=+10000000000
# WhatsApp sender (Twilio sandbox number, or an approved Business sender), with
# the "whatsapp:" prefix Twilio expects, e.g. whatsapp:+14155238886. Reuses
# TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN above. Leave unset to keep the WhatsApp
# channel on the logging fallback.
TWILIO_WHATSAPP_FROM_NUMBER=

# ─────────────────────────────────────────────
# vision-measure "notify me when it's ready" (POST /vision-measure/notify)
# ─────────────────────────────────────────────
# Shared secret vision-measure (apps/vision-measure) must send back as
# x-vision-internal-key. That route can trigger a real email/SMS/WhatsApp send,
# and it is unauthenticated (vision-measure has no operator session to
# present) — set the SAME value in apps/vision-measure/.env before this route
# is reachable from outside the container. Leave both unset for local dev.
VISION_INTERNAL_SECRET=
# Requests per hour per client IP, independent of the shared secret above.
VISION_NOTIFY_RATE_LIMIT_PER_HOUR=30

# ─────────────────────────────────────────────
# Store settings (admin-configurable defaults)
# ─────────────────────────────────────────────
# These env vars are the DEFAULTS used until the owner saves values in the admin
# (GET/POST /admin/store-settings). Once a row exists, the admin values win; the
# owner email/SMS above are the fallbacks for the notification settings.
# Default payment provider offered at checkout until changed in the admin.
# One of: pp_stripe_stripe | pp_paypal_paypal | pp_square_square.
DEFAULT_PAYMENT_PROVIDER=pp_stripe_stripe
# Sales-tax rate applied to FRAME-ONLY purchases (no prescription). Prescription
# eyewear is tax-exempt and never taxed. Decimal ("0.07") or percent ("7%").
# Empty/0 = no frame tax. The admin (frame_tax_rate) overrides this once set.
STORE_FRAME_TAX_RATE=0

# ─────────────────────────────────────────────
# Medusa Admin API key (used by scraper)
# ─────────────────────────────────────────────
MEDUSA_ADMIN_API_KEY=your-medusa-admin-api-key

# ─────────────────────────────────────────────
# Storefront URL
# ─────────────────────────────────────────────
# Public origin of the capri-storefront SPA. ONE variable with three consumers:
# PayPal return/cancel redirects, the order-confirmation email, and the
# order-tracking magic link. Getting it wrong doesn't fail loudly — it mails
# customers links pointing at a host that isn't yours.
# Dev: the Vite server runs on 5198 (apps/capri-storefront package.json `dev`).
# Prod: the deployed Vercel domain, same origin listed in STORE_CORS.
STOREFRONT_URL=http://localhost:5198

# ── Seguimiento de pedidos (enlace mágico) ──────────────────────────────────
# Firma los tokens de acceso. Si falta, se usa JWT_SECRET / COOKIE_SECRET.
# Rotarlo invalida todas las sesiones de seguimiento emitidas.
ORDER_ACCESS_SECRET=change-me-in-production
# Nombre de la tienda que aparece en el asunto del enlace mágico.
STORE_NAME=
# Solicitudes de enlace/soporte por hora, por IP y por dirección (defecto 10).
ORDER_ACCESS_RATE_LIMIT_PER_HOUR=10
# Administradores extra copiados en cada pedido pagado (separados por comas).
# El dashboard de administración puede sobrescribir esta lista.
STORE_ADMIN_NOTIFICATION_EMAILS=
# Buzón que recibe los mensajes de soporte del seguimiento de pedidos.
STORE_SUPPORT_EMAIL=

# ─────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────
# Selects which .env file Medusa loads at boot (loadEnv in medusa-config.ts) and
# is set by the container in production — you rarely set it by hand locally.
NODE_ENV=development

# ─────────────────────────────────────────────
# Email smoke test — dev only
# ─────────────────────────────────────────────
# Used only by `medusa exec src/scripts/send-test-email.ts`, which sends through
# the real notification module to prove provider + credentials + registration
# all work. Never read by the running server.
# Recipient. Falls back to STORE_ORDER_NOTIFICATION_EMAIL, then RESEND_FROM_EMAIL.
TEST_EMAIL_TO=
# "plain" (default) sends a minimal message; "order" renders the real customer
# order-confirmation template with sample data, "admin" the store's copy — how
# you iterate on the layout without placing an order.
TEST_EMAIL_TEMPLATE=plain
# Locale for the rendered template ("es" default, "en").
TEST_EMAIL_LOCALE=es
