# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DATABASE_URL=postgres://eyewear:eyewear@localhost:5432/eyewear

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────
# Medusa auth / CORS
# ─────────────────────────────────────────────
JWT_SECRET=change-me-in-production
COOKIE_SECRET=change-me-in-production
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000
BACKEND_URL=http://localhost:9000

# ─────────────────────────────────────────────
# Cloudflare R2 (S3-compatible)
# ─────────────────────────────────────────────
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=eyewear-assets
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
# Public CDN URL for assets (Cloudflare custom domain or r2.dev)
R2_PUBLIC_URL=https://assets.example.com

# ─────────────────────────────────────────────
# Meilisearch
# ─────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=change-me-in-production

# ─────────────────────────────────────────────
# Stripe
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─────────────────────────────────────────────
# PayPal
# ─────────────────────────────────────────────
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_SANDBOX=true

# ─────────────────────────────────────────────
# Square
# ─────────────────────────────────────────────
SQUARE_ACCESS_TOKEN=your-square-sandbox-token
SQUARE_LOCATION_ID=your-square-location-id
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=your-square-webhook-signature-key

# ─────────────────────────────────────────────
# Anthropic (OCR)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────────
# Resend (transactional email)
# ─────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=orders@example.com

# ─────────────────────────────────────────────
# Medusa Admin API key (used by scraper)
# ─────────────────────────────────────────────
MEDUSA_ADMIN_API_KEY=your-medusa-admin-api-key
