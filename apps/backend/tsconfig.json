{
  "extends": "../../tsconfig.base.json",
  "ts-node": {
    "transpileOnly": true
  },
  "compilerOptions": {
    // Medusa derives its build output folder from `outDir` and expects the
    // standard `.medusa/server` layout: compiled sources under `src/` plus a
    // `medusa-config.js` at the root. Do NOT set `rootDir` — stripping the
    // `src/` prefix breaks module resolution at runtime, because the loaders
    // always look for the project's routes/modules under `<cwd>/src`.
    "outDir": "./.medusa/server",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  // `medusa-config.ts` must be part of the program so it gets emitted next to
  // the compiled sources — `medusa start` loads it from the output folder.
  "include": ["src", "medusa-config.ts"],
  // `src/admin` is JSX/ESM built by the admin bundler (Vite), not by this
  // CommonJS server build — it has its own tsconfig.
  "exclude": ["node_modules", "dist", ".medusa", "tests", "src/admin"]
}
