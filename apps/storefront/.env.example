# ─────────────────────────────────────────────
# Backend connection
# ─────────────────────────────────────────────
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=your-medusa-publishable-key

# ─────────────────────────────────────────────
# Meilisearch (public read key)
# ─────────────────────────────────────────────
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=your-meilisearch-search-only-key

# ─────────────────────────────────────────────
# Cloudflare R2 / CDN
# ─────────────────────────────────────────────
NEXT_PUBLIC_CDN_HOSTNAME=assets.example.com
NEXT_PUBLIC_CDN_URL=https://assets.example.com

# ─────────────────────────────────────────────
# Payments (public keys only — secret keys stay on backend)
# ─────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
NEXT_PUBLIC_SQUARE_APP_ID=your-square-app-id
NEXT_PUBLIC_SQUARE_LOCATION_ID=your-square-location-id
