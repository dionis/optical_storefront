# Copy to .env in this directory (apps/vision-measure/.env) — it is loaded from the
# service's own root, never from the monorepo root. Every key below is OPTIONAL: the
# try-on's AI panel lets the operator type a key by hand, and what is typed in the UI
# always wins over what is here. An already-exported shell variable wins over this file.

# ---------------------------------------------------------------------------
# Multimodal measurement providers — at least one is needed for the "AI option 2"
# panel to work without the operator supplying their own key.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Qwen: Alibaba Cloud Model Studio (DashScope) console
QWEN_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
# Optional gateway: one key for Llama 4, Grok, Qwen, etc.
OPENROUTER_API_KEY=

# Hosts the image-proxy route (GET /api/vision-measure/image-proxy) is allowed to fetch
# on the caller's behalf, comma-separated. Used to pre-fill the try-on's "Imagen del
# espejuelo" from the storefront's own catalog photo without hitting the browser's CORS
# restriction on the supplier's image host. Deliberately allowlisted, not open — never
# widen this to "fetch anything the caller asks for".
#
# Leave unset to use the default: caprioptics.com (raw supplier hotlinks, still what
# some local/dev catalog data points at) plus whatever host R2_PUBLIC_URL / R2_ENDPOINT
# already resolve to — the same bucket the rest of the project trusts for product
# images (Supabase Storage in this deployment). Only set this explicitly to ADD a host
# beyond those two, not to replace them.
#VISION_IMAGE_PROXY_ALLOWED_HOSTS=

# Port and host this service listens on. The storefront/try-on frontend proxies
# `/api/*` to this address (VISION_API_URL in apps/vto-web/vite.config.ts, or the
# reverse-proxy path in production — see apps/vision-measure/README.md).
VISION_API_PORT=8008
VISION_API_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Retry budget against a congested provider (Gemini 503/429, mainly). Tunable
# without a redeploy because "how long a capacity spike usually lasts" is an
# operational fact, not something to hardcode once. See providers.py for the
# reasoning behind these defaults.
# ---------------------------------------------------------------------------
#VISION_MAX_RETRIES=6
#VISION_RETRY_BASE_DELAY_S=2.0
#VISION_RETRY_MAX_DELAY_S=60.0

# ---------------------------------------------------------------------------
# "Notify me when it's ready" — from the second retryable failure onward (see
# SLOW_NOTICE_AFTER_ATTEMPT in providers.py), the panel can arm an email/
# WhatsApp delivery instead of waiting on screen. This
# service stays stateless: it only composes the message and hands it to the
# Medusa backend below, which already has Resend/Twilio configured.
# ---------------------------------------------------------------------------
# Where the Medusa backend listens. In dev they run as sibling processes on the
# host (see `pnpm dev:backend`); in production they run in the same container
# (see apps/backend/docker-entrypoint.sh), so 127.0.0.1 reaches it either way.
MEDUSA_BACKEND_URL=http://127.0.0.1:9000
# Shared secret sent as `x-vision-internal-key` when calling the backend's
# POST /vision-measure/notify. That route can send real email/SMS/WhatsApp, so
# leaving this unset (both here and in apps/backend/.env) is fine for local
# dev but should be set before that route is reachable from outside the
# container in production.
#VISION_INTERNAL_SECRET=
