# ─────────────────────────────────────────────
# capri-storefront (Vite SPA) environment
# ─────────────────────────────────────────────
# All storefront env vars MUST be prefixed with VITE_ to be exposed to the
# client bundle. NEVER put secrets here — everything in this file ships to the
# browser. The publishable key below is safe to expose by design; anything
# secret (admin API keys, provider secrets) belongs only in the backend .env.
# Copy this file to `.env` (or `.env.local`) and fill in the values.

# ─────────────────────────────────────────────
# Static catalog (current / default data source)
# ─────────────────────────────────────────────
# Base URL where the daily cloud sync service publishes the catalog JSON files
# (catalog.json, cases.json, catalog-meta.json). Leave empty to read them from
# the SPA's own origin (public/*.json). Set to a hosted base (no trailing slash)
# to decouple the storefront from any local machine, e.g.:
#   VITE_CATALOG_URL=https://cdn.myshop.com/catalog
VITE_CATALOG_URL=

# ─────────────────────────────────────────────
# Medusa backend (Store API) — Phase 0+ integration
# ─────────────────────────────────────────────
# Base URL of the Medusa backend. Dev default is http://localhost:9000.
# In production point this at the deployed backend (Coolify / VPS) origin.
VITE_MEDUSA_URL=http://localhost:9000

# Publishable API key created in the Medusa admin and associated with the sales
# channel the storefront sells from. Store keys are prefixed `pk_...` and are
# safe to expose in the client. See docs/phase-0-setup.md for how to create it.
VITE_MEDUSA_PUBLISHABLE_KEY=

# Feature flag for the incremental migration from static JSON to the Medusa
# Store API. Keep "false" until a page is actually wired to Medusa; set "true"
# to route supported pages through the backend.
VITE_USE_MEDUSA=false

# ─────────────────────────────────────────────
# Feature flags (src/config/features.js)
# ─────────────────────────────────────────────
# Virtual try-on (camera + 3D frame overlay). Enabled by default; set to "false"
# to hide every try-on entry point (product card pill, PDP buttons). Accepts
# true/false, 1/0, on/off, yes/no.
VITE_ENABLE_TRY_ON=true

# Public base URL of the R2 bucket that hosts product images. Product image keys
# stored in Medusa are bare object keys (e.g. products/<handle>/x.webp); the
# storefront prefixes this to build the full URL. Leave empty when the scraper
# hotlinks absolute supplier URLs (dev/no-R2 mode).
VITE_R2_PUBLIC_URL=
