# ─────────────────────────────────────────────
# capri-storefront (Vite SPA) environment
# ─────────────────────────────────────────────
# All storefront env vars MUST be prefixed with VITE_ to be exposed to the
# client bundle. NEVER put secrets here — everything in this file ships to the
# browser. The publishable key below is safe to expose by design; anything
# secret (admin API keys, provider secrets) belongs only in the backend .env.
# Copy this file to `.env` (or `.env.local`) and fill in the values.

# ─────────────────────────────────────────────
# Static catalog (current / default data source)
# ─────────────────────────────────────────────
# Base URL where the daily cloud sync service publishes the catalog JSON files
# (catalog.json, cases.json, catalog-meta.json). Leave empty to read them from
# the SPA's own origin (public/*.json). Set to a hosted base (no trailing slash)
# to decouple the storefront from any local machine, e.g.:
#   VITE_CATALOG_URL=https://cdn.myshop.com/catalog
VITE_CATALOG_URL=

# ─────────────────────────────────────────────
# Medusa backend (Store API) — Phase 0+ integration
# ─────────────────────────────────────────────
# Base URL of the Medusa backend. Dev default is http://localhost:9000.
# In production point this at the deployed backend (Coolify / VPS) origin.
VITE_MEDUSA_URL=http://localhost:9000

# Publishable API key created in the Medusa admin and associated with the sales
# channel the storefront sells from. Store keys are prefixed `pk_...` and are
# safe to expose in the client. See docs/phase-0-setup.md for how to create it.
VITE_MEDUSA_PUBLISHABLE_KEY=

# Feature flag for the incremental migration from static JSON to the Medusa
# Store API. Keep "false" until a page is actually wired to Medusa; set "true"
# to route supported pages through the backend.
VITE_USE_MEDUSA=false

# ─────────────────────────────────────────────
# Payments
# ─────────────────────────────────────────────
# Stripe publishable key (`pk_test_...` / `pk_live_...`), safe to expose. Without
# it the checkout refuses to mount and shows the "checkout.noStripe" message —
# there is no fallback. It MUST come from the same Stripe environment (sandbox or
# live) as the backend's STRIPE_SECRET_KEY: mixing a pk_test with an sk_live, or
# keys from two different sandboxes, makes confirmPayment fail on a client secret
# the other side never issued.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Payment provider the checkout initiates a session with. Defaults to
# pp_stripe_stripe when unset. One of:
#   pp_stripe_stripe | pp_paypal_paypal | pp_square_square
# The backend exposes the owner's choice at GET /store/store-settings; set this
# only to pin the storefront to a provider regardless of that setting.
VITE_DEFAULT_PAYMENT_PROVIDER=pp_stripe_stripe

# ─────────────────────────────────────────────
# Feature flags (src/config/features.js)
# ─────────────────────────────────────────────
# Virtual try-on (camera + 3D frame overlay). Enabled by default; set to "false"
# to hide every try-on entry point (product card pill, PDP buttons). Accepts
# true/false, 1/0, on/off, yes/no.
VITE_ENABLE_TRY_ON=true

# Where the try-on iframe (TryOn3D.jsx) points. The try-on itself lives in
# apps/vto-web, a separate Vite app — not part of this bundle. Dev default is
# its own dev server (127.0.0.1:3000, run via `pnpm --filter eyewear-vto-web dev`
# or the root `pnpm dev`); in production it is built into
# apps/capri-storefront/public/tryon-3d/ and served same-origin (see root
# vercel.json), so set this to "/tryon-3d" there.
VITE_TRYON3D_URL=http://localhost:3000

# Public base URL of the R2 bucket that hosts product images. Product image keys
# stored in Medusa are bare object keys (e.g. products/<handle>/x.webp); the
# storefront prefixes this to build the full URL. Leave empty when the scraper
# hotlinks absolute supplier URLs (dev/no-R2 mode).
VITE_R2_PUBLIC_URL=

# Google Maps JavaScript API key (Places library). When set, the checkout's
# "Patient details" street field gets Google-style address autocomplete that
# fills the separate street / ZIP / city / country fields. Leave empty to use
# the manual separate fields — the build never depends on Google being present.
VITE_GOOGLE_MAPS_KEY=

# ─────────────────────────────────────────────
# Corporate panel (/admin)
# ─────────────────────────────────────────────
# The panel's Orders tab reads and mutates REAL orders through the Medusa Admin
# API, so its login is Medusa's own: sign in with the same email/password that
# opens the Medusa dashboard. There is no storefront-specific admin password.
#
# Admin traffic deliberately ignores VITE_MEDUSA_URL and goes through the
# same-origin proxy (`/medusa/...`, rewritten by vercel.json in production and
# by the Vite dev proxy locally). The admin and auth routes sit behind their own
# CORS allowlists (adminCors / authCors), and a generated Vercel preview origin
# will never be on them — the proxy sidesteps that entirely. Set this only for a
# deployment that has no proxy in front of it (no trailing slash).
VITE_ADMIN_MEDUSA_URL=

# Restores the OLD open panel login (any email + any password) for deploying the
# panel as a disconnected showcase with no backend behind it. MUST stay unset or
# "false" anywhere real orders exist — it disables the login entirely.
VITE_ADMIN_DEMO_LOGIN=false
