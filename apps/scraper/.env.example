# ─────────────────────────────────────────────
# Medusa Admin API
# ─────────────────────────────────────────────
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_ADMIN_API_KEY=your-medusa-admin-api-key
# Sales channel the storefront sells from. Products are associated with it on push
# so the Store API (publishable key) returns them. Get the id from the admin —
# see docs/phase-0-setup.md. Leave empty to skip the association (products won't
# show in the storefront until linked).
MEDUSA_SALES_CHANNEL_ID=

# ─────────────────────────────────────────────
# Object storage (S3-compatible: Cloudflare R2, Supabase Storage, MinIO, Garage)
# ─────────────────────────────────────────────
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=eyewear-assets
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# SigV4 signing region: "auto" for Cloudflare R2, the real region for most other
# providers (e.g. us-east-2 for Supabase Storage) — they reject "auto".
R2_REGION=auto
# Public read base URL. Keys are appended as-is, so include any bucket path the
# provider requires (Supabase: https://<ref>.supabase.co/storage/v1/object/public/<bucket>)
R2_PUBLIC_URL=https://assets.example.com

# ─────────────────────────────────────────────
# Meilisearch (for post-ingest reindex trigger)
# ─────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=change-me-in-production

# ─────────────────────────────────────────────
# AI translation (optional — es/fr title+description generation is skipped
# gracefully if unset, falling back to English-only content)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────
# Scraper behavior
# ─────────────────────────────────────────────
# Rate limit: seconds between requests (float)
SCRAPER_RATE_LIMIT=1.0
SCRAPER_USER_AGENT=EyewearStoreBot/1.0 (+contact@example.com)

# ─────────────────────────────────────────────
# Generated media  (python -m scraper media …)
# ─────────────────────────────────────────────
# Only `media generate` needs these; `plan`, `status` and `retry` work without
# them. Get a key at https://aistudio.google.com/apikey.
#
# THIS KEY SPENDS MONEY PER REQUEST. The whole catalogue is ~$223 of images;
# every run is bounded by a mandatory --max-cost and by the server-side ceiling.
GEMINI_API_KEY=
# Optional overrides — the vendored module reads these itself.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview

# ─────────────────────────────────────────────
# R2 / S3 object storage
# ─────────────────────────────────────────────
# Required by both the image pipeline and media generation. Without them
# `media generate` refuses to start: generated views have no supplier URL to
# fall back on, so a run without storage would pay for images and discard them.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=eyewear-assets
# Cloudflare R2 wants the literal "auto"; most other S3-compatible backends
# (Supabase Storage among them) reject it and want the real region.
R2_REGION=auto
R2_PUBLIC_URL=
