+
+/* ===================================================================
+   ETAPA 134 — Lámina de MATERIALES (aros 3D) + RESUMEN móvil más
+   compacto (el cliente seguía sin verlo en una sola vista con la línea
+   de Transitions). Los materiales cuentan su historia: menos aros =
+   lente más delgado (1.74 un aro fino, 1.67 dos, policarbonato tres,
+   CR-39 las capas clásicas); blanco/oro en la fila elegida.
+   =================================================================== */
+.i3d-fab { height: 22px; width: auto; flex: 0 0 auto; }
+.zlx-fab.has-i3d:not(.no-i3d) > svg.zlx-ic { display: none; }
+@media (max-width: 939px) {
+  /* Pasos del resumen en FILA (icono · rótulo · check): más bajos y legibles. */
+  .zlx-pop-rx.zlx-rx-stage-summary .zlx-summary-steps .zlx-fab {
+    flex-direction: row; justify-content: center; align-items: center; gap: 8px;
+    min-height: 44px; padding: 4px 12px;
+  }
+  .zlx-pop-rx.zlx-rx-stage-summary .zlx-summary-steps .zlx-fab-txt { flex: 0 1 auto; }
+  .zlx-pop-rx.zlx-rx-stage-summary .zlx-summary-steps .zlx-fab-txt b { font-size: 13px; }
+  .zlx-pop-rx.zlx-rx-stage-summary .zlx-summary-steps { gap: 5px; margin-top: 6px; }
+  /* Ficha y resumen un punto más bajos para absorber líneas extra
