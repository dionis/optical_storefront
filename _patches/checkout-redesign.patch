+  .zlx-pop-rx.zlx-rx-stage-summary .fs-card.ts2-frame .fs-photo,
+  .zlx-pop-rx.zlx-rx-stage-summary .fs-card.ts2-frame .fs-photo.has-gen { height: 9vh; height: 9dvh; }
+  .zlx-pop-rx.zlx-rx-stage-summary .zlx-summary-navyhd { padding: 7px 12px; }
+  .zlx-pop-rx.zlx-rx-stage-summary .zlx-summary-navybody { padding: 6px 12px 8px; }
+  .zlx-pop-rx.zlx-rx-stage-summary .zlx-summary-list li { padding: 2px 0; font-size: 13.5px; }
+  .zlx-pop-rx.zlx-rx-stage-summary .zlx-summary-total { font-size: 18px; margin-top: 4px; padding-top: 4px; }
+  .zlx-pop-rx.zlx-rx-stage-summary .zlx-buy-left { margin-top: 6px; }
+}
+
+/* ===================================================================
+   ETAPA 135 — CHECKOUT rediseñado + CARRITO vistoso (pedidos del
+   cliente): números en navy (fuera el rojo), título centrado con la
+   tarjeta dorada y "Seguir comprando" a la izquierda, resumen con la
+   ficha COMPLETA (foto del espejuelo, cristal, tratamientos, receta),
+   envío SIN botón (aparece al poner la dirección; el botón es PAGAR),
+   dirección con autocompletado (Google o el respaldo abierto), y el
+   carrito con marca de agua del logo y mensajes de confianza.
+   =================================================================== */
+/* Cabecera del checkout */
+.co-head { display: grid; gap: 2px; margin-bottom: 6px; }
+.co-head .co-backlink { justify-self: start; margin: 0; font-size: 13px; }
+.co-head .co-title {
+  justify-self: center; display: flex; align-items: center; gap: 10px;
+  margin: 0; font-size: 24px; text-align: center;
+}
+.co-title-ic { height: 30px; width: auto; }
+/* Números del pedido en NAVY (el rojo no es del estilo de la casa). */
+.checkout .panel-item-price { color: #0b2f66; }
+.checkout .panel-total { border-top: 2px solid #d9b85c; }
+.checkout .panel-total span { color: var(--cuba-blue); }
+.checkout .panel-total b { color: #0b2f66; }
+.checkout .co-totals > div b { color: #0b2f66; }
+/* Resumen con cabecera navy (como la ficha del espejuelo) */
+.co-summary2 { padding: 0; overflow: hidden; border-radius: 14px; }
+.co-sum-navyhd {
