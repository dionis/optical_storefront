+  .zlx-pop-rx.zlx-rx-stage-summary .zlx-page-side .zlx-frameside .fs-mval { font-size: 13.5px; }
+  .zlx-pop-rx.zlx-rx-stage-summary .zlx-page-side .zlx-frameside .fs-mcell { padding: 6px 4px 8px; }
