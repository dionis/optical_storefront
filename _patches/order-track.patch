+.trk-box { border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px 15px; margin: 10px 0 18px; background: #fff; }
+.trk-hd { display: flex; align-items: center; gap: 9px; font-size: 15.5px; color: var(--cuba-blue); }
+.trk-hd .i3d { height: 24px; width: auto; }
+.trk-intro { font-size: 13px; margin: 4px 0 10px; }
+.trk-form { display: grid; grid-template-columns: 150px 1fr auto; gap: 8px; align-items: stretch; }
+.trk-form input { border: 1.5px solid var(--line); border-radius: 10px; padding: 9px 12px; font-size: 14px; min-width: 0; }
+.btn.btn-primary.trk-go {
+  background: none !important; box-shadow: none !important;
+  border: 14px solid transparent !important;
+  border-image: url("/ui/glass/bar-navy-gold.png") 34 fill stretch !important;
+  border-radius: 0; min-height: 46px; padding: 0 14px;
+  color: #f3e3b3 !important; text-shadow: 0 1px 2px rgba(0, 0, 0, .38); white-space: nowrap;
+}
+.trk-result { margin-top: 12px; border-top: 1px dashed var(--line); padding-top: 10px; }
+.trk-result-hd { display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: baseline; margin-bottom: 6px; }
+.trk-result-hd > b { color: #0b2f66; font-size: 15px; }
+.trk-guide { font-size: 12.5px; color: var(--ink-soft); }
+.trk-guide b { color: #0b2f66; }
+.trk-dates { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 18px; }
+.trk-dates li { display: flex; gap: 6px; font-size: 12.5px; color: var(--ink-soft); }
+.trk-dates li b { color: #0b2f66; }
+.trk-follow { display: inline-block; margin-top: 8px; font-weight: 700; color: var(--cuba-blue); }
+.trk-note { display: block; margin-top: 8px; }
+@media (max-width: 700px) {
+  .trk-form { grid-template-columns: 1fr 1fr; }
+  .trk-form input[type=email] { grid-column: 1 / -1; grid-row: 1; }
+  .btn.btn-primary.trk-go { grid-column: 1 / -1; }
+}
