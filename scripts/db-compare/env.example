# Copy to .env.db-compare in the repo root (ignored by git) and fill in.
# Use the read-only role from readonly-role.sql, never the app's user.
# Supabase pooler: user = db_compare_ro.<PROJECT_REF>; URL-encode the password.

PROD_DATABASE_URL=postgresql://db_compare_ro.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
STAGING_DATABASE_URL=postgresql://db_compare_ro.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional: the app's DB user name (no password) so the fingerprint can be
# checked against STAGING_DATABASES / FORBIDDEN_DATABASES in demo-seed.ts.
PROD_APP_DB_USER=
STAGING_APP_DB_USER=
